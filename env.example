# Copy this file to a new file named exactly:  .env   (with the dot, no .txt)
# Then paste your own keys after the = signs. Never share the .env file.
ADZUNA_APP_ID=paste_your_app_id_here
ADZUNA_APP_KEY=paste_your_app_key_here
# Country of the job market: in = India, gb = UK, us = USA, au = Australia, ca = Canada
ADZUNA_COUNTRY=in
